# Xcode / xcodegen
# ios/Example/Example.xcodeproj is generated by `xcodegen generate` from
# ios/Example/project.yml, which is the source of truth -- keep the
# generated project (and Info.plist, generated the same way) out of version
# control so there's only one thing to keep in sync.
ios/Example/Example.xcodeproj/
ios/Example/ExampleApp/Info.plist
DerivedData/

